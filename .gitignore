# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.so

# Virtual environments
.env/
.venv/
env/
venv/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# System-specific files
.DS_Store
Thumbs.db

# Data (raw dataset, interim/processed artifacts) - large and regenerable.
# Directory structure is preserved via .gitkeep; actual contents are ignored.
/data/**
!/data/**/
!/data/**/.gitkeep

# Trained models and checkpoints - large and regenerable via training
/models/

# Raw hyperparameter-search trial artifacts - large and regenerable
/results/hyperparameter_search/

# Model artifacts that can appear outside models/ (e.g. under notebooks/)
*.h5
*.ckpt
*.pb
*.tflite
variables/

# Packaging / test / type-check artifacts
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs
*.log

# Archives
*.zip
*.tar.gz
REFACTOR_PLAN.md
